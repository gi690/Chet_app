{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "lastSeen": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Message": {
      "title": "Message",
      "description": "A chat message",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "imageUrl": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderPhoto": { "type": "string" },
        "roomId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "senderId", "createdAt", "roomId"]
    },
    "ChatRoom": {
      "title": "Chat Room",
      "description": "A collaborative chat space",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "createdBy": { "type": "string" },
        "members": { "type": "array", "items": { "type": "string" } },
        "isPrivate": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "createdBy", "createdAt"]
    },
    "Call": {
      "title": "Call",
      "description": "WebRTC signaling document",
      "type": "object",
      "properties": {
        "callerId": { "type": "string" },
        "receiverId": { "type": "string" },
        "offer": { "type": "object" },
        "answer": { "type": "object" },
        "status": { "type": "string", "enum": ["incoming", "active", "ended"] }
      }
    },
    "AiTask": {
      "title": "AI Task",
      "description": "Task for Google Gemini multimodal extension",
      "type": "object",
      "properties": {
        "prompt": { "type": "string" },
        "response": { "type": "string" },
        "status": { "type": "object" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["prompt", "createdBy", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "rooms/{roomId}": {
      "schema": "ChatRoom",
      "description": "Chat rooms"
    },
    "rooms/{roomId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages within a room"
    },
    "calls/{callId}": {
      "schema": "Call",
      "description": "Call signaling data"
    },
    "admins/{userId}": {
      "schema": { "type": "object", "properties": { "role": { "enum": ["admin"] } } },
      "description": "Administrator list"
    },
    "ai_tasks/{taskId}": {
      "schema": "AiTask",
      "description": "Multimodal AI generation tasks"
    }
  }
}
